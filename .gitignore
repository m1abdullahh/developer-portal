packages/db/src/generated/
next-env.d.ts

# env
.env
.env.local
.env.*.local
!.env.example

# secrets — never commit
*.pem
*.key
github-app-*.private-key.pem

# test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# generator scratch output
.tmp/
tmp-out/
generated-out/

# db
*.db
*.db-journal
*.sqlite
*.sqlite3

# editor / os
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# Projects the portal provisions with the filesystem driver (VCS_OUTPUT_DIR). These are whole
# generated repositories written at runtime — committing them would put a copy of every
# scaffolded project inside this one.
.idp-output/

# Playwright output. `test-results/` is already ignored above; these two are not.
playwright-report/
blob-report/
.playwright/
