# Portal configuration. Copy to .env.local for development.

# ── Database ─────────────────────────────────────────────────────────────────
# Shared with packages/db. A relative path resolves against the portal's working
# directory, so point it at the db package rather than assuming a copy.
DATABASE_URL="file:../../packages/db/dev.db"

# ── Authentication ───────────────────────────────────────────────────────────
# Required by Auth.js to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth app credentials. Without these, GitHub sign-in is not offered at all.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The organisation whose members may use the portal. A valid GitHub login is NOT
# sufficient — using the portal means creating repositories in this org, so membership
# is checked against the API at sign-in. With no org set, sign-in is refused outright:
# an internal portal open to every GitHub account is not a safe default.
GITHUB_ORG=""

# Optional. Team slugs that grant elevated roles, resolved from org team membership at
# sign-in. With neither set, every org member may provision — a legitimate small-team
# setup where the org itself is the boundary.
GITHUB_ADMIN_TEAM=""
GITHUB_PROVISIONER_TEAM=""

# Local development identity, used when OAuth credentials are not available. Refused
# when NODE_ENV=production, so a misconfigured deployment fails closed rather than
# quietly accepting an unauthenticated user.
# AUTH_DEV_LOGIN="your-name"
# AUTH_DEV_ROLE="admin"

# ── Provisioning ─────────────────────────────────────────────────────────────
# "filesystem" (default) writes generated projects to a local directory. "github"
# creates real repositories. Filesystem is the default deliberately: a misconfigured
# deployment should write a directory nobody reads, not create repositories with
# whatever credentials it inherited.
VCS_DRIVER="filesystem"
VCS_OUTPUT_DIR="./.idp-output"

# Required when VCS_DRIVER=github. A GitHub App installation token, not a personal token.
# GITHUB_TOKEN=""
# GITHUB_API_URL=""   # GitHub Enterprise only

# ── Wizard defaults ──────────────────────────────────────────────────────────
# Pre-fills the organisation field. Public — it reaches the browser.
NEXT_PUBLIC_GITHUB_ORG=""
