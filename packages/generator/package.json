{
  "name": "@idp/generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@idp/core": "*",
    "@idp/templates": "*",
    "ejs": "6.0.1",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "ts-morph": "28.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/node": "22.20.1",
    "@types/semver": "7.7.1"
  },
  "bin": {
    "idp": "./dist/cli/index.js"
  }
}
