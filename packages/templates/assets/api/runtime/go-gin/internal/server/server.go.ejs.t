package server

import (
	"net/http"

	"github.com/gin-gonic/gin"

	"github.com/<%= spec.meta.repo.org %>/<%= spec.meta.slug %>/internal/config"
	"github.com/<%= spec.meta.repo.org %>/<%= spec.meta.slug %>/internal/routes"
	// >>> idp:imports
	// <<< idp:imports
